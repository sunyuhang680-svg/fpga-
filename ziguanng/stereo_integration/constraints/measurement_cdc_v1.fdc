# REVIEW-ONLY candidate modeled on cdc_reset_candidate_v4; NOT validated or applied.
# Generated hierarchy and pin names MUST be checked against the NEW design and actual reports.
# Only first-stage D and asynchronous reset assertion pins are candidates for exceptions.
# Keep synchronizer stage-to-stage D/CLK and reset recovery/removal paths timed.
# Bundled-data max delay 8 ns assumes every relevant receiver period >=8 ns; verify clocks.
# held payload stability through ACK is supplied by stereo_event_cdc; no whole-clock cut.
set_false_path -to [get_pins -hierarchical {measurement_enabled.measurement/command_cdc/req_meta*/D*}]
set_false_path -to [get_pins -hierarchical {measurement_enabled.measurement/command_cdc/ack_meta*/D*}]
set_max_delay 8.000 -datapath_only -from [get_cells -hierarchical {measurement_enabled.measurement/command_cdc/held*}] -to [get_cells -hierarchical {measurement_enabled.measurement/command_cdc/dst_data*}]
set_false_path -hold -from [get_cells -hierarchical {measurement_enabled.measurement/command_cdc/held*}] -to [get_cells -hierarchical {measurement_enabled.measurement/command_cdc/dst_data*}]
set_false_path -to [get_pins -hierarchical {measurement_enabled.measurement/command_cdc/reset_domains.source_reset_sync*/C measurement_enabled.measurement/command_cdc/reset_domains.source_reset_sync*/P}]
set_false_path -to [get_pins -hierarchical {measurement_enabled.measurement/command_cdc/reset_domains.destination_reset_sync*/C measurement_enabled.measurement/command_cdc/reset_domains.destination_reset_sync*/P}]
