# New photo helper CDC. Object matching and physical STA are separate gates.
# Only first-stage asynchronous inputs and reset assertion pins are cut.
# Stage-to-stage D/CLK paths and local reset-release recovery remain timed.
# Coherent payload stays held through request/ACK. 8ns is the 125MHz receiver bound.
set_false_path -to [get_pins -hierarchical {photo_hold0/mailbox/req_meta*/D*}]
set_false_path -to [get_pins -hierarchical {photo_hold0/mailbox/ack_meta*/D*}]
set_max_delay 8.000 -datapath_only -from [get_cells -hierarchical {photo_hold0/mailbox/held*}] -to [get_cells -hierarchical {photo_hold0/mailbox/dst_data*}]
set_false_path -hold -from [get_cells -hierarchical {photo_hold0/mailbox/held*}] -to [get_cells -hierarchical {photo_hold0/mailbox/dst_data*}]
set_false_path -to [get_pins -hierarchical {photo_hold0/mailbox/reset_domains.source_reset_sync*/C photo_hold0/mailbox/reset_domains.source_reset_sync*/P}]
set_false_path -to [get_pins -hierarchical {photo_hold0/mailbox/reset_domains.destination_reset_sync*/C photo_hold0/mailbox/reset_domains.destination_reset_sync*/P}]
set_false_path -to [get_pins -hierarchical {photo_hold0/camera_reset*/C photo_hold0/camera_reset*/P}]
set_false_path -to [get_pins -hierarchical {photo_hold1/mailbox/req_meta*/D*}]
set_false_path -to [get_pins -hierarchical {photo_hold1/mailbox/ack_meta*/D*}]
set_max_delay 8.000 -datapath_only -from [get_cells -hierarchical {photo_hold1/mailbox/held*}] -to [get_cells -hierarchical {photo_hold1/mailbox/dst_data*}]
set_false_path -hold -from [get_cells -hierarchical {photo_hold1/mailbox/held*}] -to [get_cells -hierarchical {photo_hold1/mailbox/dst_data*}]
set_false_path -to [get_pins -hierarchical {photo_hold1/mailbox/reset_domains.source_reset_sync*/C photo_hold1/mailbox/reset_domains.source_reset_sync*/P}]
set_false_path -to [get_pins -hierarchical {photo_hold1/mailbox/reset_domains.destination_reset_sync*/C photo_hold1/mailbox/reset_domains.destination_reset_sync*/P}]
set_false_path -to [get_pins -hierarchical {photo_hold1/camera_reset*/C photo_hold1/camera_reset*/P}]
set_false_path -to [get_pins -hierarchical {display_descriptors.left_descriptor/response/req_meta*/D*}]
set_false_path -to [get_pins -hierarchical {display_descriptors.left_descriptor/response/ack_meta*/D*}]
set_max_delay 8.000 -datapath_only -from [get_cells -hierarchical {display_descriptors.left_descriptor/response/held*}] -to [get_cells -hierarchical {display_descriptors.left_descriptor/response/dst_data*}]
set_false_path -hold -from [get_cells -hierarchical {display_descriptors.left_descriptor/response/held*}] -to [get_cells -hierarchical {display_descriptors.left_descriptor/response/dst_data*}]
set_false_path -to [get_pins -hierarchical {display_descriptors.left_descriptor/response/reset_domains.source_reset_sync*/C display_descriptors.left_descriptor/response/reset_domains.source_reset_sync*/P}]
set_false_path -to [get_pins -hierarchical {display_descriptors.left_descriptor/response/reset_domains.destination_reset_sync*/C display_descriptors.left_descriptor/response/reset_domains.destination_reset_sync*/P}]
set_false_path -to [get_pins -hierarchical {display_descriptors.left_descriptor/pixel_reset*/C display_descriptors.left_descriptor/pixel_reset*/P}]
set_false_path -to [get_pins -hierarchical {display_descriptors.left_descriptor/memory_reset*/C display_descriptors.left_descriptor/memory_reset*/P}]
set_false_path -to [get_pins -hierarchical {display_descriptors.right_descriptor/response/req_meta*/D*}]
set_false_path -to [get_pins -hierarchical {display_descriptors.right_descriptor/response/ack_meta*/D*}]
set_max_delay 8.000 -datapath_only -from [get_cells -hierarchical {display_descriptors.right_descriptor/response/held*}] -to [get_cells -hierarchical {display_descriptors.right_descriptor/response/dst_data*}]
set_false_path -hold -from [get_cells -hierarchical {display_descriptors.right_descriptor/response/held*}] -to [get_cells -hierarchical {display_descriptors.right_descriptor/response/dst_data*}]
set_false_path -to [get_pins -hierarchical {display_descriptors.right_descriptor/response/reset_domains.source_reset_sync*/C display_descriptors.right_descriptor/response/reset_domains.source_reset_sync*/P}]
set_false_path -to [get_pins -hierarchical {display_descriptors.right_descriptor/response/reset_domains.destination_reset_sync*/C display_descriptors.right_descriptor/response/reset_domains.destination_reset_sync*/P}]
set_false_path -to [get_pins -hierarchical {display_descriptors.right_descriptor/pixel_reset*/C display_descriptors.right_descriptor/pixel_reset*/P}]
set_false_path -to [get_pins -hierarchical {display_descriptors.right_descriptor/memory_reset*/C display_descriptors.right_descriptor/memory_reset*/P}]
set_false_path -to [get_pins -hierarchical {photo_configuration_cdc/req_meta*/D*}]
set_false_path -to [get_pins -hierarchical {photo_configuration_cdc/ack_meta*/D*}]
set_false_path -to [get_pins -hierarchical {photo_configuration_cdc/reset_domains.source_reset_sync*/C photo_configuration_cdc/reset_domains.source_reset_sync*/P}]
set_false_path -to [get_pins -hierarchical {photo_configuration_cdc/reset_domains.destination_reset_sync*/C photo_configuration_cdc/reset_domains.destination_reset_sync*/P}]
set_false_path -to [get_pins -hierarchical {photo_ddr_ready*/D[0]}]
set_false_path -to [get_pins -hierarchical {photo_pixel_reset*/C photo_pixel_reset*/P}]
