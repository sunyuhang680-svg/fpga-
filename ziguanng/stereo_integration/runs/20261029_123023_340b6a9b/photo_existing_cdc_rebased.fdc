# CANDIDATE ONLY: apply in a NEW complete Compile/Map/PNR run together with original FDC.
# These constraints do not replace clocks or physical IO constraints.
# First metastability sampling D only; second stages keep normal same-clock timing.
# Payload stays held until acknowledgment. Capture is >=2 receiver periods later.
# All relevant receiver periods are >=8ns; bound payload max delay to 8ns.
# Hold relationship between unrelated clocks is replaced by protocol hold through ACK.
# Async assertion endpoints: only logical C/P pins of reviewed reset synchronizers.
# Synchronizer D/CLK pins, local reset recovery/removal and same-domain paths stay timed.
# No DDR exceptions, whole-clock false paths or IO delay guesses.
set_false_path -to [get_pins -hierarchical {display_descriptors.left_descriptor/forward/active_meta*/D*}]
set_false_path -to [get_pins -hierarchical {display_descriptors.left_descriptor/forward/ack_meta*/D*}]
set_max_delay 8.000 -datapath_only -from [get_cells -hierarchical {display_descriptors.left_descriptor/forward/held*}] -to [get_cells -hierarchical {display_descriptors.left_descriptor/forward/mem_base* display_descriptors.left_descriptor/forward/mem_index* display_descriptors.left_descriptor/forward/mem_tag*}]
set_false_path -hold -from [get_cells -hierarchical {display_descriptors.left_descriptor/forward/held*}] -to [get_cells -hierarchical {display_descriptors.left_descriptor/forward/mem_base* display_descriptors.left_descriptor/forward/mem_index* display_descriptors.left_descriptor/forward/mem_tag*}]
