# New testing60 CDC only. Endpoint matching and routed path reports REQUIRED.
# Neither this file nor component single-clock STA signs off asynchronous CDC.
# 8 ns datapath limit: shortest receiver clock is DDR core 125 MHz.
set_false_path -to [get_pins -hierarchical {u_testing60_quality_0/finish_cdc/req_meta*/D*}]
set_false_path -to [get_pins -hierarchical {u_testing60_quality_0/finish_cdc/ack_meta*/D*}]
set_max_delay 8.000 -datapath_only -from [get_cells -hierarchical {u_testing60_quality_0/finish_cdc/held*}] -to [get_cells -hierarchical {u_testing60_quality_0/finish_cdc/dst_data*}]
set_false_path -hold -from [get_cells -hierarchical {u_testing60_quality_0/finish_cdc/held*}] -to [get_cells -hierarchical {u_testing60_quality_0/finish_cdc/dst_data*}]
set_false_path -to [get_pins -hierarchical {u_testing60_quality_0/finish_cdc/reset_domains.source_reset_sync*/C u_testing60_quality_0/finish_cdc/reset_domains.source_reset_sync*/P}]
set_false_path -to [get_pins -hierarchical {u_testing60_quality_0/finish_cdc/reset_domains.destination_reset_sync*/C u_testing60_quality_0/finish_cdc/reset_domains.destination_reset_sync*/P}]
set_false_path -to [get_pins -hierarchical {u_testing60_quality_0/quality_cdc/req_meta*/D*}]
set_false_path -to [get_pins -hierarchical {u_testing60_quality_0/quality_cdc/ack_meta*/D*}]
set_max_delay 8.000 -datapath_only -from [get_cells -hierarchical {u_testing60_quality_0/quality_cdc/held*}] -to [get_cells -hierarchical {u_testing60_quality_0/quality_cdc/dst_data*}]
set_false_path -hold -from [get_cells -hierarchical {u_testing60_quality_0/quality_cdc/held*}] -to [get_cells -hierarchical {u_testing60_quality_0/quality_cdc/dst_data*}]
set_false_path -to [get_pins -hierarchical {u_testing60_quality_0/quality_cdc/reset_domains.source_reset_sync*/C u_testing60_quality_0/quality_cdc/reset_domains.source_reset_sync*/P}]
set_false_path -to [get_pins -hierarchical {u_testing60_quality_0/quality_cdc/reset_domains.destination_reset_sync*/C u_testing60_quality_0/quality_cdc/reset_domains.destination_reset_sync*/P}]
set_false_path -to [get_pins -hierarchical {u_testing60_quality_0/camera_reset_sync*/C u_testing60_quality_0/camera_reset_sync*/P}]
set_false_path -to [get_pins -hierarchical {u_testing60_quality_0/core_reset_sync*/C u_testing60_quality_0/core_reset_sync*/P}]
set_false_path -to [get_pins -hierarchical {testing60_capture_reset_0*/C testing60_capture_reset_0*/P}]
set_false_path -to [get_pins -hierarchical {u_testing60_capture_0/ack_sync*/D[0]}]
# Stable bank payload sampled only during the existing writer ACK window.
set_max_delay 8.000 -datapath_only -from [get_cells -hierarchical {cmos_write_req_gen_inst0/write_addr_index*}] -to [get_cells -hierarchical {u_testing60_quality_0/memory_index*}]
set_false_path -hold -from [get_cells -hierarchical {cmos_write_req_gen_inst0/write_addr_index*}] -to [get_cells -hierarchical {u_testing60_quality_0/memory_index*}]
set_false_path -to [get_pins -hierarchical {u_testing60_quality_1/finish_cdc/req_meta*/D*}]
set_false_path -to [get_pins -hierarchical {u_testing60_quality_1/finish_cdc/ack_meta*/D*}]
set_max_delay 8.000 -datapath_only -from [get_cells -hierarchical {u_testing60_quality_1/finish_cdc/held*}] -to [get_cells -hierarchical {u_testing60_quality_1/finish_cdc/dst_data*}]
set_false_path -hold -from [get_cells -hierarchical {u_testing60_quality_1/finish_cdc/held*}] -to [get_cells -hierarchical {u_testing60_quality_1/finish_cdc/dst_data*}]
set_false_path -to [get_pins -hierarchical {u_testing60_quality_1/finish_cdc/reset_domains.source_reset_sync*/C u_testing60_quality_1/finish_cdc/reset_domains.source_reset_sync*/P}]
set_false_path -to [get_pins -hierarchical {u_testing60_quality_1/finish_cdc/reset_domains.destination_reset_sync*/C u_testing60_quality_1/finish_cdc/reset_domains.destination_reset_sync*/P}]
set_false_path -to [get_pins -hierarchical {u_testing60_quality_1/quality_cdc/req_meta*/D*}]
set_false_path -to [get_pins -hierarchical {u_testing60_quality_1/quality_cdc/ack_meta*/D*}]
set_max_delay 8.000 -datapath_only -from [get_cells -hierarchical {u_testing60_quality_1/quality_cdc/held*}] -to [get_cells -hierarchical {u_testing60_quality_1/quality_cdc/dst_data*}]
set_false_path -hold -from [get_cells -hierarchical {u_testing60_quality_1/quality_cdc/held*}] -to [get_cells -hierarchical {u_testing60_quality_1/quality_cdc/dst_data*}]
set_false_path -to [get_pins -hierarchical {u_testing60_quality_1/quality_cdc/reset_domains.source_reset_sync*/C u_testing60_quality_1/quality_cdc/reset_domains.source_reset_sync*/P}]
set_false_path -to [get_pins -hierarchical {u_testing60_quality_1/quality_cdc/reset_domains.destination_reset_sync*/C u_testing60_quality_1/quality_cdc/reset_domains.destination_reset_sync*/P}]
set_false_path -to [get_pins -hierarchical {u_testing60_quality_1/camera_reset_sync*/C u_testing60_quality_1/camera_reset_sync*/P}]
set_false_path -to [get_pins -hierarchical {u_testing60_quality_1/core_reset_sync*/C u_testing60_quality_1/core_reset_sync*/P}]
set_false_path -to [get_pins -hierarchical {testing60_capture_reset_1*/C testing60_capture_reset_1*/P}]
set_false_path -to [get_pins -hierarchical {u_testing60_capture_1/ack_sync*/D[0]}]
# Stable bank payload sampled only during the existing writer ACK window.
set_max_delay 8.000 -datapath_only -from [get_cells -hierarchical {cmos_write_req_gen_inst1/write_addr_index*}] -to [get_cells -hierarchical {u_testing60_quality_1/memory_index*}]
set_false_path -hold -from [get_cells -hierarchical {cmos_write_req_gen_inst1/write_addr_index*}] -to [get_cells -hierarchical {u_testing60_quality_1/memory_index*}]
